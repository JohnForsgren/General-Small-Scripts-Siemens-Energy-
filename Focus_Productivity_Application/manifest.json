{
  "manifest_version": 3,
  "name": "Focus Productivity Manager",
  "version": "1.0.0",
  "description": "A local-only productivity extension that hides distracting YouTube sections.",
  "action": {
    "default_title": "Focus Productivity Manager",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}